<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/lorie_ic_settings"
        android:shortcutId="preferences"
        android:shortcutShortLabel="@string/preferences_button_text"
        tools:ignore="UnusedAttribute">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="@@APPLICATION_ID@@"
            android:targetClass="com.termux.x11.LoriePreferences" />
    </shortcut>
    <!-- shiroikuma fork (Phase 4): the 白い熊 Termux X11 UI page, one long-press away from the launcher icon. -->
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/lorie_ic_launcher"
        android:shortcutId="shiroikuma_ui"
        android:shortcutShortLabel="@string/shiroikuma_ui_shortcut_short"
        android:shortcutLongLabel="@string/shiroikuma_ui_shortcut_long"
        tools:ignore="UnusedAttribute">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="@@APPLICATION_ID@@"
            android:targetClass="com.termux.x11.shiroikuma.ShiroikumaUiActivity" />
    </shortcut>
</shortcuts>
