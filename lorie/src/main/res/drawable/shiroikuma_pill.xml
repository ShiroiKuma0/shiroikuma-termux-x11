<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the house pill — black fill, 1.5 dp yellow stroke, fully rounded, yellow ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFF00">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <stroke android:width="1.5dp" android:color="#FFFF00" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</ripple>
