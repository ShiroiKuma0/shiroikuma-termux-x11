    <string name="shiroikuma_auto_switch">Automation export</string>
    <string name="shiroikuma_auto_switch_desc">Let sister apps (白い熊 応用管理, 白い熊 自由作業盤) run this export headlessly and back its data up. On by default.</string>
    <string name="shiroikuma_auto_require_token">Use authorization token?</string>
    <string name="shiroikuma_auto_require_token_desc">Off: any sister app may drive the automation. On: a caller must also present the token below. Either way the data door checks the caller’s package name and signature.</string>
