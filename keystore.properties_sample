# Copy to keystore.properties (gitignored, repo root) and fill in the signing details.
# lorie-app/shiroikuma.gradle reads these four keys for BOTH signing configs (release, and the
# `debug` one the shell-loader derives its certificate check from). The whole com.termux shared-UID
# family (shiroikuma-emacs, -termux, -termux-api, -termux-x11, -termux-gui) must use ONE keystore.
storeFile=/home/you/.android-keystores/your-key.jks
storePassword=changeme
keyAlias=your alias
keyPassword=changeme
